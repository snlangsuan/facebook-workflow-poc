# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NODE_ENV=local
HOST=localhost
PORT=8000
# Public base URL of this app (no trailing slash). Used to build the TikTok redirect URI.
BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────
# Google / Firebase (Admin SDK service account)
# ─────────────────────────────────────────────────────────────
GOOGLE_PROJECT_ID=your-firebase-project-id
GOOGLE_LOCATION=us-central1
GOOGLE_AUTH_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the literal \n escapes from the service-account JSON; the app converts them at runtime.
GOOGLE_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Public Firebase Web API key (browser uses it to refresh ID tokens).
FIREBASE_WEB_API_KEY=
# Realtime Database URL (optional; defaults to the project's RTDB).
FIREBASE_DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# Facebook (Graph API / Login)
# ─────────────────────────────────────────────────────────────
FACEBOOK_APP_ID=4503288803286309
FACEBOOK_APP_SECRET=<secret>
FACEBOOK_VERIFY_TOKEN=facebook_verify_token_123
FACEBOOK_GRAPH_VERSION=v25.0

# ─────────────────────────────────────────────────────────────
# TikTok Login Kit (OAuth 2.0) — https://developers.tiktok.com
# Register the redirect URI in the TikTok console as:
#   ${BASE_URL}/demo/api/v1/tiktok/callback
# ─────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=<tiktok_client_key>
TIKTOK_CLIENT_SECRET=<tiktok_client_secret>
TIKTOK_SCOPE=user.info.basic
# Optional override. Leave blank to use ${BASE_URL}/demo/api/v1/tiktok/callback
TIKTOK_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────
# Gemini (AI auto-reply)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
